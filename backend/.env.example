DATA_DIR=../data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_COMPLEX_MODEL=gpt-6-astra
# Explicit, labelled offline examples when no key is configured.
DEMO_MODE=true
SEED_DEMO=true
COOKIE_SECURE=false
# Development email links appear in the signup/reset response in demo mode.
# Turn demo mode off and configure SMTP before using real accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=werkruimte@example.com
APP_URL=http://localhost:3000
