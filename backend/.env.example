DATA_DIR=../data
# Install native Codex CLI and run codex login on the host PC.
AI_PROVIDER=codex
CODEX_BINARY=
CODEX_MODEL=gpt-6.1-sol
CODEX_DOCUMENT_MODEL=gpt-6.1-sol
# Explicit offline examples can be selected in admin settings with provider=demo.
# Controls sample accounts and development email links, separately from AI provider.
DEMO_MODE=true
SEED_DEMO=true
COOKIE_SECURE=false
# Development email links appear in the signup/reset response in demo mode.
# Turn demo mode off and configure SMTP before using real accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=werkruimte@example.com
APP_URL=http://localhost:3000

# Enable only on the Windows PC with licensed Office installed.
OFFICE_DESKTOP_ENABLED=false
